extends SceneTree
func _initialize() -> void: call_deferred("check")
func press(game: Node, keycode: Key) -> void:
	var key := InputEventKey.new()
	key.keycode = keycode
	key.pressed = true
	game._input(key)
func hole_out(game: Node, count: int) -> void:
	game.strokes = count
	game.ball_position = game.CUP + Vector3(0, game._ground_height(game.CUP.x, game.CUP.z) + game.BALL_RADIUS, 0)
	game.velocity = Vector3.ZERO
	assert(game._complete_hole())
	assert(not game._complete_hole(), "score must be recorded only once")
func check() -> void:
	var game = load("res://tests/legacy_course.gd").game()
	root.add_child(game)
	await process_frame
	assert(game.wind_index > 0, "opening wind must not be calm")
	assert(game.hole_index == 0 and int(game.HOLES[0].par) == 4)
	press(game, KEY_N)
	assert(game.hole_index == 0, "cannot skip an unfinished hole")
	hole_out(game, 5)
	assert(game.hole_scores == [5] and game._round_relative() == 1)
	assert(game.message.contains("Press N"))
	press(game, KEY_N)
	assert(game.hole_index == 1 and game.hole_scores == [5])
	assert(game.strokes == 0 and not game.hole_complete and game.club_index == game.recommended_club and game.club_index != 0)
	assert(game.wind_index > 0 and game.active_hole.yards == 207.0 and absf(game._distance_to_cup(game.TEE) - 194.03) < .1)
	assert(game._in_water(Vector3(-42, 0, -103)) and not game._in_water(Vector3(44, 0, -120)))
	game._update_hud()
	assert(game.hud.hole_card.badge_text() == "2" and game.hud.hole_card.par_text().contains("PAR 3"))
	game.strokes = 2
	press(game, KEY_R)
	assert(game.hole_index == 1 and game.strokes == 0 and game.hole_scores == [5])
	hole_out(game, 2)
	assert(game.hole_scores == [5, 2] and game._round_relative() == 0)
	assert(game.message.contains("Press N"))
	press(game, KEY_N)
	assert(game.hole_index == 2 and game.hole_scores == [5, 2])
	assert(int(game.HOLES[2].par) == 4 and game.active_hole.yards == 345.0 and absf(game._distance_to_cup(game.TEE) - 315.54) < .1)
	assert(not game.elevation_samples.is_empty())
	game._update_hud()
	assert(game.hud.hole_card.badge_text() == "3" and game.hud.hole_card.par_text().contains("PAR 4"))
	hole_out(game, 4)
	assert(game.hole_scores == [5, 2, 4] and game.message.contains("Press N"))
	press(game, KEY_N)
	assert(game.hole_index == 3 and game.hole_scores == [5, 2, 4])
	assert(int(game.HOLES[3].par) == 5 and game.HOLES[3].yards == 544.0)
	assert(game._distance_to_cup(game.TEE) * game.YARDS_PER_METER < 544.0)
	game._update_hud()
	assert(game.hud.hole_card.badge_text() == "4" and game.hud.hole_card.par_text().contains("PAR 5"))
	hole_out(game, 5)
	assert(game.hole_scores == [5, 2, 4, 5] and game.message.contains("ROUND COMPLETE"))
	press(game, KEY_N)
	assert(game.hole_index == 3 and game.hole_scores == [5, 2, 4, 5])
	press(game, KEY_R)
	assert(game.hole_index == 0 and game.hole_scores.is_empty() and game.strokes == 0)
	assert(game.wind_index > 0)
	print("PASS nonzero wind, scoring, progression, restart and full round")
	quit()
